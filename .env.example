# Copy to .env (not committed) or export in your shell. Every value is optional.

# Where the server listens, and the URL players use to reach it.
GRADO_BIND=127.0.0.1:8787
GRADO_PUBLIC_URL=http://localhost:8787

GRADO_DATABASE_URL=sqlite://grado.db
GRADO_CONTENT_DIR=content
GRADO_WEB_DIR=web

# Only `dev` exists in v1: sign in with name + email, no password.
GRADO_AUTH_MODE=dev
# Comma-separated emails that can open the Game master view.
GRADO_ADMIN_EMAILS=

# Hosts the MCP endpoint accepts (defaults to localhost plus the public URL's host).
GRADO_ALLOWED_HOSTS=

GRADO_STAMP_TTL_HOURS=24
GRADO_SESSION_TTL_DAYS=30

# Rubric checks use Claude when a key is set, and an offline keyword grader otherwise.
ANTHROPIC_API_KEY=
GRADO_GRADER_MODEL=claude-opus-5-5
GRADO_GRADER_EFFORT=medium
